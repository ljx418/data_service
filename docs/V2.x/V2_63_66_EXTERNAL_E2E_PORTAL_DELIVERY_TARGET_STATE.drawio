          <mxGeometry x="60" y="40" width="1480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="baseA" value="已验收能力层&#xa;Human-Agent Deepening&#xa;Stabilization E2E Portal&#xa;MCP / CLI / HTTP adapters&#xa;public surface guard&#xa;V2.46-V2.62 tests and audits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;align=left;spacing=12;" vertex="1" parent="1">
