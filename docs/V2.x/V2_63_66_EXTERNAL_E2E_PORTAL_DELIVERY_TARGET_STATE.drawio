        </mxCell>
        <mxCell id="entry" value="入口门槛&#xa;drawio 人类确认&#xa;V2.59-V2.62 final audit 存在&#xa;外部项目路径重新确认或结构化标记&#xa;phase-specific plan 和 audit 无 fatal/major" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;align=left;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="120" y="470" width="420" height="230" as="geometry" />
        </mxCell>
        <mxCell id="exit" value="最终出门条件&#xa;data_service 真实 E2E accepted&#xa;外部项目 accepted 或结构化不可用且不计 accepted&#xa;Portal V3+ 呈现目标体验&#xa;Delivery manifest 可审查&#xa;Contract regression 可诊断&#xa;baseline tests / public guard / compileall / diff check 通过" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=16;align=left;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="590" y="470" width="470" height="230" as="geometry" />
        </mxCell>
        <mxCell id="rollback" value="打回规则&#xa;fatal/major 偏差&#xa;unavailable 写成 accepted&#xa;Portal 隐藏风险状态&#xa;cleanup 自动删除文件&#xa;breaking contract 静默通过&#xa;protected legacy 文件被未授权修改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;align=left;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1110" y="470" width="360" height="230" as="geometry" />
        </mxCell>
      </root>
