        <mxCell id="a2" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="gapA" target="targetA">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="targetA" target="outA">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel1" value="关系规则&#xa;1. 新组件读取既有 artifact 与 public adapters&#xa;2. 不改写 legacy 大文件&#xa;3. 不把 unavailable 计入 accepted&#xa;4. Portal 只读 persisted artifacts&#xa;5. Delivery 只生成计划，不删除文件&#xa;6. Contract regression 只诊断，不静默改合同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;align=left;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="190" y="560" width="1220" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
