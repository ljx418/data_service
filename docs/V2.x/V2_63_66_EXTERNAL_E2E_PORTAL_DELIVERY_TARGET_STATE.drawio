  <diagram id="v2_63_66_04" name="04 开发与验收计划">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title4" value="分阶段执行计划：每步产物、体验和验收" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#17365D;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="1480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dev63" value="V2.63 外部项目 E2E&#xa;做什么：项目预检、build/read、Portal read、contract read&#xa;产物：full_project_matrix、run_records、artifact_readiness、E2E report&#xa;体验：看到 data_service/codexPat/HarnessOS/Navia 谁真通过、谁不可用、为什么&#xa;验收：不可用不能 accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="170" width="340" height="330" as="geometry" />
        </mxCell>
        <mxCell id="dev64" value="V2.64 维护者首页&#xa;做什么：生成首页、项目 E2E、合同、交付、风险、出门面板&#xa;产物：experience_model、navigation_model、status_panels、HTML&#xa;体验：不用翻文档即可判断能用什么、风险在哪、下一步做什么&#xa;验收：只读 artifact，不隐藏坏消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=14;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="170" width="340" height="330" as="geometry" />
        </mxCell>
        <mxCell id="dev65" value="V2.65 交付版本化&#xa;做什么：读取工作树，分类源码、测试、文档、验收证据、临时文件&#xa;产物：version_manifest、review_package_manifest、cleanup_plan、delivery_audit&#xa;体验：知道哪些该提交、保留、复核&#xa;验收：只给清理计划，不自动删除" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=14;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="170" width="340" height="330" as="geometry" />
        </mxCell>
        <mxCell id="dev66" value="V2.66 合同回归&#xa;做什么：比较 baseline/current 的 MCP、CLI、HTTP、artifact schema&#xa;产物：contract_baseline、contract_diff、compatibility_report、diagnosis&#xa;体验：修改 public surface 前知道是否破坏合同&#xa;验收：breaking change 必须复核或阻塞" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1190" y="170" width="340" height="330" as="geometry" />
        </mxCell>
        <mxCell id="loop" value="每个子阶段固定闭环&#xa;计划：development plan + acceptance plan + pre-implementation audit&#xa;实现：build artifacts + read artifacts + public surface parity&#xa;验收：focused tests + real E2E + PRD/spec review + false-green audit + acceptance audit&#xa;决策：通过进入下一阶段；失败打回计划；fatal/major 偏差停下确认" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;align=left;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="180" y="620" width="1240" height="210" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
