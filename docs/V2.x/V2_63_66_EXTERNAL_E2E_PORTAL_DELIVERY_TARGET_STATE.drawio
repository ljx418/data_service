<mxfile host="Electron" agent="Codex" pages="6">
  <diagram id="v2_63_66_01" name="01 阶段目标与目标体验">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title1" value="V2.63-V2.66 阶段目标：外部证据更完整、Portal 更可读、交付更稳定、合同可回归" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#17365D;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="1480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cur1" value="当前基线&#xa;1. V2.54-V2.62 已验收&#xa;2. data_service 可作为真实 E2E 基线&#xa;3. 外部项目仍可能 structured_unavailable&#xa;4. Portal 已集成阶段状态，但目标体验仍需强化&#xa;5. 工作树和交付包需要版本化解释&#xa;6. public surface 有 guard，但缺少跨阶段合同回归" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;align=left;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="160" width="430" height="310" as="geometry" />
        </mxCell>
        <mxCell id="target1" value="目标体验&#xa;1. 维护者看到真实外部 E2E 状态和失败原因&#xa;2. Portal 直接呈现能力、风险、下一步和出门状态&#xa;3. 交付包能解释源码、测试、文档、验收产物、临时文件&#xa;4. MCP / CLI / HTTP / artifact schema 可做合同回归&#xa;5. Agent 修改前能获得合同、E2E、交付和 stop condition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=16;align=left;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="590" y="160" width="430" height="310" as="geometry" />
        </mxCell>
        <mxCell id="boundary1" value="硬边界&#xa;不声称完整恢复设计意图&#xa;不声称 full call graph / runtime topology / data-control flow / type inference&#xa;documentation claim 不能当 code fact&#xa;needs_review / structured_unavailable / structured_blocker 不能写成 accepted&#xa;不自动删除用户文件&#xa;不改 protected legacy 大文件，除非用户明确批准" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;align=left;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1100" y="160" width="420" height="310" as="geometry" />
        </mxCell>
        <mxCell id="p63" value="V2.63&#xa;外部项目完整 E2E&#xa;data_service / codexPat / HarnessOS / Navia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="570" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p64" value="V2.64&#xa;Portal V3+ 体验强化&#xa;维护者首页、状态面板、风险和下一步" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="570" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p65" value="V2.65&#xa;交付清理与版本化&#xa;manifest、review package、cleanup plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="570" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p66" value="V2.66&#xa;Public Surface Contract Regression&#xa;baseline、diff、compatibility、diagnosis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1140" y="570" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="p63" target="p64">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="p64" target="p65">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="p65" target="p66">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2_63_66_02" name="02 当前架构到目标架构">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
