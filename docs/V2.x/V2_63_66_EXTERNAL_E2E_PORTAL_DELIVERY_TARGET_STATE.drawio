  <diagram id="v2_63_66_06" name="06 验收门槛与目标能力">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title6" value="维护者首页与状态面板：快速判断项目能否出门" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#17365D;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="1480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ux1" value="首页回答的问题&#xa;当前哪些能力真的可用？&#xa;哪些外部项目 E2E 通过？&#xa;哪些风险阻止出门？&#xa;交付包是否清晰可审查？&#xa;下一步应该做什么？" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=16;align=left;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="90" y="180" width="430" height="300" as="geometry" />
        </mxCell>
        <mxCell id="cap1" value="核心状态面板&#xa;阶段总览：planning / implementing / accepted / blocked&#xa;外部 E2E：项目状态、命令、证据、失败分类&#xa;合同稳定性：MCP / CLI / HTTP / schema&#xa;交付状态：提交、证据、临时、人工复核&#xa;风险与下一步：高/中/低优先级" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;align=left;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="590" y="180" width="430" height="300" as="geometry" />
        </mxCell>
        <mxCell id="evidence" value="每个面板必须显示&#xa;status&#xa;artifact_ref&#xa;evidence_ref&#xa;unresolved reason&#xa;next_action&#xa;&#xa;没有证据就不能显示 accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;align=left;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1090" y="180" width="430" height="300" as="geometry" />
        </mxCell>
        <mxCell id="noaccept" value="首页不允许做的事&#xa;把 structured_unavailable / needs_review / structured_blocker 弱化成通过&#xa;只在 HTML 里硬编码结论&#xa;隐藏 warning / unresolved&#xa;把外部项目缺失写成 accepted&#xa;把 cleanup plan 当成自动删除&#xa;把 relationship / impact candidate 写成 full call graph 或 runtime call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;align=left;spacing=14;" vertex="1" parent="1">
