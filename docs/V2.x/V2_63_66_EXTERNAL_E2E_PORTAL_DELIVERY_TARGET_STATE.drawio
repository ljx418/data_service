        </mxCell>
        <mxCell id="gapA" value="当前差距&#xa;外部项目 E2E 未完全 accepted&#xa;Portal 状态可读性仍需强化&#xa;dirty worktree 缺少版本化说明&#xa;contract guard 缺少跨阶段 diff 和兼容性诊断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="170" width="330" height="250" as="geometry" />
        </mxCell>
        <mxCell id="targetA" value="目标能力层&#xa;External Full E2E Orchestrator&#xa;Portal V3+ Experience Composer&#xa;Delivery Version Manager&#xa;Public Surface Contract Regression Engine&#xa;阶段 focused tests and audits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=16;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="170" width="330" height="250" as="geometry" />
        </mxCell>
        <mxCell id="outA" value="目标输出&#xa;external_e2e/*&#xa;portal_v3/*&#xa;delivery/*&#xa;contract_regression/*&#xa;phase acceptance reports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1320" y="170" width="210" height="250" as="geometry" />
        </mxCell>
        <mxCell id="a1" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="baseA" target="gapA">
          <mxGeometry relative="1" as="geometry" />
