  <diagram id="v2_86_90_01" name="01 阶段目标与用户体验">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1_title" value="V2.86-V2.90 阶段目标：全量真实文档验收与发布闭环加固" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#17365D;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="40" width="1500" height="70" as="geometry" /></mxCell>
        <mxCell id="p1_legend" value="颜色说明：绿色=已实现可复用；蓝色=本阶段待新增；黄色=需人工确认；红色=阻断或禁止；灰色=外部条件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="1440" height="55" as="geometry" /></mxCell>
        <mxCell id="p1_current" value="当前事实&#xa;V2.81-V2.83 Route B 已 accepted&#xa;V2.84 质量治理 = needs_review&#xa;V2.85 release closure = structured_unavailable&#xa;完整 docs/V2.x 构建暴露 Section 错误&#xa;Route A 代表性资料未完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="80" y="230" width="430" height="300" as="geometry" /></mxCell>
        <mxCell id="p1_goal" value="目标体验&#xa;维护者能用全量真实文档完成导入、构建、检索、GraphRAG、Source trace、质量审查和发布出门判断&#xa;&#xa;审计者能看到真实证据、截图或 headless evidence、unresolved 原因和 false-green 防线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=17;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="590" y="230" width="430" height="300" as="geometry" /></mxCell>
        <mxCell id="p1_release" value="最终体验边界&#xa;Route A 缺失不能 final accepted&#xa;外部项目缺路径不能 accepted&#xa;human approval 缺失不能 release accepted&#xa;HTML extractor 失败不能隐藏&#xa;不得声称完整设计意图恢复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="1090" y="230" width="430" height="300" as="geometry" /></mxCell>
        <mxCell id="p1_v86" value="V2.86&#xa;全量 docs 构建加固" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="650" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="p1_v87" value="V2.87&#xa;Route A 资料包验收" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="650" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="p1_v88" value="V2.88&#xa;质量治理人工审查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="650" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="p1_v89" value="V2.89&#xa;外部项目真实 E2E" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="650" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="p1_v90" value="V2.90&#xa;Release gate 出门判断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1210" y="650" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="p1_e1" value="补强为可审计闭环" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="p1_current" target="p1_goal"><mxGeometry relative="1" as="geometry" /></mxCell>
