        <mxCell id="1" parent="0" />
        <mxCell id="p6_title" value="质量治理与纠错审查：自动建议必须进入人工 review，不能直接 accepted" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#17365D;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="40" width="1500" height="70" as="geometry" /></mxCell>
        <mxCell id="p6_current" value="当前 V2.84 状态&#xa;quality_governance_review.json 已有自动产物&#xa;correction_acceptance_report.md 已有建议&#xa;缺人工 quality review&#xa;状态 = needs_review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="80" y="190" width="390" height="230" as="geometry" /></mxCell>
        <mxCell id="p6_review" value="待新增人工审查&#xa;human_quality_review.json&#xa;reviewer decision&#xa;evidence refs&#xa;reject reason&#xa;next action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="590" y="190" width="360" height="230" as="geometry" /></mxCell>
        <mxCell id="p6_history" value="纠错决策历史&#xa;correction_decision_history.jsonl&#xa;accept / reject / needs_review&#xa;每条建议有 evidence 或 unresolved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="1070" y="190" width="380" height="230" as="geometry" /></mxCell>
        <mxCell id="p6_rule" value="规则影响复核&#xa;rule_effect_review.md&#xa;上游 hash 只读校验&#xa;不改写原始 artifact&#xa;保留弱证据和矛盾项" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="360" y="560" width="390" height="210" as="geometry" /></mxCell>
        <mxCell id="p6_gate" value="验收门槛&#xa;无人工审查 = needs_review&#xa;无 evidence = needs_review&#xa;改写上游 artifact = blocker&#xa;隐藏 unresolved = false-green" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="880" y="560" width="390" height="210" as="geometry" /></mxCell>
        <mxCell id="p6_e1" value="进入人工审查" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="p6_current" target="p6_review"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p6_e2" value="记录逐条决策" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="p6_review" target="p6_history"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p6_e3" value="复核规则影响" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="p6_history" target="p6_rule"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p6_e4" value="汇入验收门禁" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#B85450;" edge="1" parent="1" source="p6_rule" target="p6_gate"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2_86_90_07" name="07 开发及验收计划">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p7_title" value="开发及验收计划：每个子阶段先审计，再实现，再 E2E，再 PRD 规格检视" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#17365D;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="40" width="1500" height="70" as="geometry" /></mxCell>
        <mxCell id="p7_86" value="V2.86 全量文档&#xa;效果：维护者能跑完整 docs/V2.x E2E&#xa;验收：构建成功或 structured_blocker&#xa;证据：full_corpus_run / parser_failures / report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="80" y="170" width="280" height="190" as="geometry" /></mxCell>
        <mxCell id="p7_87" value="V2.87 Route A&#xa;效果：用户代表性资料可人工验收&#xa;验收：资料包、脱敏、截图、签核&#xa;缺资料：needs_review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="390" y="170" width="280" height="190" as="geometry" /></mxCell>
        <mxCell id="p7_88" value="V2.88 质量审查&#xa;效果：质量建议可被人类接受或拒绝&#xa;验收：human_quality_review / decision_history&#xa;缺审查：needs_review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="700" y="170" width="280" height="190" as="geometry" /></mxCell>
        <mxCell id="p7_89" value="V2.89 外部项目&#xa;效果：每个外部项目状态可审计&#xa;验收：真实 E2E 或 structured_unavailable&#xa;缺路径：不能 accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="1010" y="170" width="280" height="190" as="geometry" /></mxCell>
        <mxCell id="p7_90" value="V2.90 出门门禁&#xa;效果：一屏判断 release 是否可出门&#xa;验收：release_gate_summary / readiness_report&#xa;缺 approval：不能 final accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="640" y="500" width="320" height="200" as="geometry" /></mxCell>
        <mxCell id="p7_audit" value="每阶段固定动作&#xa;1 开发计划和验收计划落盘&#xa;2 pre-implementation audit 无 fatal/major&#xa;3 实现后 focused tests&#xa;4 真实 E2E&#xa;5 PRD/spec review&#xa;6 false-green audit&#xa;7 acceptance audit report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="1050" y="500" width="400" height="250" as="geometry" /></mxCell>
        <mxCell id="p7_e1" endArrow="block" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="p7_86" target="p7_87"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p7_e2" endArrow="block" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="p7_87" target="p7_88"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p7_e3" endArrow="block" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="p7_88" target="p7_89"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p7_e4" value="汇总" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="p7_89" target="p7_90"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p7_e5" value="每阶段重复执行" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="p7_audit" target="p7_90"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2_86_90_08" name="08 里程碑、验收门槛与出门条件">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p8_title" value="里程碑、验收门槛与出门条件：真实资料、质量审查、外部项目、人工审批缺一不可" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#17365D;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="40" width="1500" height="70" as="geometry" /></mxCell>
        <mxCell id="p8_m1" value="M1 V2.86&#xa;全量 docs E2E&#xa;构建成功或 blocker 明确" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="260" height="120" as="geometry" /></mxCell>
        <mxCell id="p8_m2" value="M2 V2.87&#xa;Route A 资料包&#xa;脱敏、截图、人工记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="370" y="160" width="260" height="120" as="geometry" /></mxCell>
        <mxCell id="p8_m3" value="M3 V2.88&#xa;质量治理审查&#xa;逐条建议有人工结论" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="670" y="160" width="260" height="120" as="geometry" /></mxCell>
        <mxCell id="p8_m4" value="M4 V2.89&#xa;外部项目闭环&#xa;真实 E2E 或 structured unavailable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="970" y="160" width="260" height="120" as="geometry" /></mxCell>
        <mxCell id="p8_m5" value="M5 V2.90&#xa;最终 release gate&#xa;审批、恢复、依赖、工作树" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1270" y="160" width="260" height="120" as="geometry" /></mxCell>
        <mxCell id="p8_gate" value="最终 accepted 必要条件&#xa;Route A accepted&#xa;Route B accepted&#xa;全量 docs E2E accepted 或有批准的 scope exception&#xa;Source trace 可追溯&#xa;质量治理有人工审查&#xa;外部项目不可用不计 accepted&#xa;restore / smoke / dependency 状态可审计&#xa;human release approval 已记录&#xa;false-green audit 无 fatal/major&#xa;protected legacy 文件无未批准 diff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="120" y="420" width="620" height="350" as="geometry" /></mxCell>
        <mxCell id="p8_block" value="阻断 final release accepted&#xa;Route A 缺失&#xa;HTML extractor 失败不可审计&#xa;quality review 缺人工确认&#xa;外部项目缺路径却被计 accepted&#xa;human approval 缺失&#xa;隐藏 needs_review / structured_unavailable / structured_blocker&#xa;声称 full call graph、runtime topology、data/control flow、type inference 或完整设计意图恢复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="850" y="420" width="620" height="350" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
