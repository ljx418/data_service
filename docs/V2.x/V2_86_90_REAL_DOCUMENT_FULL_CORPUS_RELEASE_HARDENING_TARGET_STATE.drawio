      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2_title" value="当前架构到目标架构差异：复用 V2.81-V2.85 能力，补齐全量文档、Route A、质量审查和出门门禁" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#17365D;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="40" width="1500" height="70" as="geometry" /></mxCell>
        <mxCell id="p2_current" value="当前已实现实体&#xa;Knowledge Console 静态前端&#xa;WorkspaceRuntime / source / session&#xa;query / graph / source trace API&#xa;real_document_acceptance/service.py&#xa;HTTP / CLI / MCP build-read surface&#xa;V2.81-V2.85 artifacts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="80" y="200" width="420" height="360" as="geometry" /></mxCell>
        <mxCell id="p2_gap" value="当前缺口&#xa;全量 docs/V2.x 构建未 accepted&#xa;HTML extractor Section 错误&#xa;Route A 用户资料缺失&#xa;质量治理缺人工 review&#xa;外部项目缺路径&#xa;human approval 缺失&#xa;npm audit 风险待记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="590" y="200" width="420" height="360" as="geometry" /></mxCell>
        <mxCell id="p2_target" value="目标新增实体&#xa;Full Corpus E2E Runner&#xa;HTML Extractor Hardening&#xa;Route A Acceptance Pack&#xa;Quality Review Recorder&#xa;External Project Closure&#xa;Release Gate Aggregator&#xa;Dependency / worktree hygiene audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="1100" y="200" width="420" height="360" as="geometry" /></mxCell>
        <mxCell id="p2_e1" value="已提供小样本真实验收基础" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="p2_current" target="p2_gap"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2_e2" value="转成下一阶段实现落点" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="p2_gap" target="p2_target"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2_forbidden" value="拒绝不清晰设计&#xa;不允许只有概念模块&#xa;不允许无 artifact 的 accepted&#xa;不允许把 unavailable 算 accepted&#xa;不允许隐藏 HTML 解析失败" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="360" y="650" width="880" height="140" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
