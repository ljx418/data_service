      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t3" value="V2.46-V2.52 Phase 123-129 开发及验收计划" style="text;html=1;fontSize=26;fontStyle=1;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p123" value="Phase 123 MCP 使用产品化&#xa;验收：Codex CLI 指南可用；tool catalog 与 registry 一致；未配置返回结构化诊断" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#eff6ff;strokeColor=#2563eb;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
