        <mxCell id="p124" value="Phase 124 Project Profile Onboarding&#xa;验收：四项目 profile 或 unavailable；no-hardcode audit passed" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f0fdf4;strokeColor=#16a34a;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="460" y="130" width="360" height="150" as="geometry" />
