          <mxGeometry x="860" y="130" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p126" value="Phase 126 Task Navigation and Impact v2&#xa;验收：真实任务 reading order；impact candidate 不称为 runtime call；测试建议有 evidence" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f3ff;strokeColor=#7c3aed;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1260" y="130" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p127" value="Phase 127 Doc-Code Governance Workflow&#xa;验收：approve/revoke overlay；原始 artifact hash 不变" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fdf2f8;strokeColor=#db2777;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="420" width="360" height="150" as="geometry" />
