          <mxGeometry x="910" y="370" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="m7" value="M7 Closure&#xa;四项目持续回归；parity；redaction；无 fatal/major" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#111827;" vertex="1" parent="1">
