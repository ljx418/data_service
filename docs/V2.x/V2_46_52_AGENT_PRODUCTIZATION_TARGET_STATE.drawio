  <diagram id="05-exit-gates" name="05 验收门槛及出门条件">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="1200">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t5" value="验收门槛及出门条件" style="text;html=1;fontSize=26;fontStyle=1;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="800" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gate1" value="证据门槛&#xa;- accepted 必须有 evidence_refs&#xa;- recommendation 必须有 evidence 或 needs_review&#xa;- artifact refs 必须可读回" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ecfdf5;strokeColor=#059669;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="420" height="180" as="geometry" />
        </mxCell>
        <mxCell id="gate2" value="安全门槛&#xa;- 无绝对路径泄露&#xa;- 无 secret/token/raw traceback&#xa;- HTML 和 Mermaid escape 通过" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fef2f2;strokeColor=#dc2626;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="130" width="420" height="180" as="geometry" />
        </mxCell>
        <mxCell id="gate3" value="架构边界&#xa;- relationship chain 不是 full call graph&#xa;- impact candidate 不是 runtime call&#xa;- doc claim 不是 code fact" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1040" y="130" width="420" height="180" as="geometry" />
        </mxCell>
        <mxCell id="gate4" value="产品化门槛&#xa;- Codex CLI 可按指南接入&#xa;- Human Portal 可读&#xa;- Agent playbook 可执行&#xa;- 四项目持续回归矩阵可审计" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#eff6ff;strokeColor=#2563eb;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="420" width="920" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="06-user-scenarios" name="06 用户体验与应用场景">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="1200">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t6" value="用户体验与应用场景" style="text;html=1;fontSize=26;fontStyle=1;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="800" height="50" as="geometry" />
        </mxCell>
        <mxCell id="u1" value="场景 1：新人接手大项目&#xa;打开 Human Portal，先看项目定位、入口、模块图、风险和 recommended reading，再决定从哪些文件开始读。" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#eff6ff;strokeColor=#2563eb;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="430" height="180" as="geometry" />
        </mxCell>
        <mxCell id="u2" value="场景 2：Codex 修 bug&#xa;Agent 通过 MCP 请求 task context，拿到 relationship chain、impact candidates、suggested tests，避免全仓重复阅读。" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f0fdf4;strokeColor=#16a34a;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="130" width="430" height="180" as="geometry" />
        </mxCell>
        <mxCell id="u3" value="场景 3：架构设计看护&#xa;审计者比较 docs/drawio target 和 current code facts，看到 supported、weak、unsupported、contradicted，留下 governance feedback。" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff7ed;strokeColor=#ea580c;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1040" y="130" width="430" height="180" as="geometry" />
        </mxCell>
        <mxCell id="u4" value="场景 4：接入新项目&#xa;先生成 profile draft，再确认 taxonomy、authority、entrypoint、workflow patterns。项目专用知识进入 profile，不污染通用 extractor。" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f3ff;strokeColor=#7c3aed;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="420" width="430" height="180" as="geometry" />
        </mxCell>
        <mxCell id="u5" value="场景 5：多项目持续回归&#xa;每次能力扩展都在 data_service、HarnessOS、Navia、codexPat 上跑回归矩阵，防止只对单项目有效。" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ecfeff;strokeColor=#0891b2;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="420" width="430" height="180" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
