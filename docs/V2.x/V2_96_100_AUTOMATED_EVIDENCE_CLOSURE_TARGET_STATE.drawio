        <mxCell id="p2_current" value="已实现可复用实体&#xa;real_acceptance_closure/runtime_restore.py&#xa;route_a_material.py&#xa;quality_decision.py&#xa;external_project_validator.py&#xa;release_finalizer.py&#xa;mcp_code_real_acceptance_closure_tools.py&#xa;code_assets_real_acceptance_closure.py&#xa;workspace/v2_91_95_real_acceptance_e2e" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="440" height="400" as="geometry"/></mxCell>
        <mxCell id="p2_gap" value="当前剩余缺口&#xa;默认 shell CLI gap 已修复&#xa;Route A 仍缺真实资料 / 脱敏 / 截图 / 人工确认&#xa;Quality 仍缺 reviewer decision&#xa;codexPat / HarnessOS / Navia 仍缺路径&#xa;dependency hygiene 和 human approval 未 accepted&#xa;docs/present 不是验收证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="590" y="180" width="440" height="400" as="geometry"/></mxCell>
        <mxCell id="p2_target" value="本阶段已落地或受限完成实体&#xa;Default CLI Entrypoint Adapter：已实现并测试&#xa;Route A Evidence Automator：已实现，最终需人工确认&#xa;Quality Decision Workbench：已实现，最终需 reviewer decision&#xa;External Project Path Registry：已实现，缺外部路径时 structured_unavailable&#xa;Release Evidence Aggregator：已实现，使用最差高风险状态&#xa;False-green Recheck：已实现并保留 non-accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="1100" y="180" width="440" height="400" as="geometry"/></mxCell>
