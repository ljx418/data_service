        <mxCell id="p6_title" value="里程碑、验收门槛与出门条件：缺一项高风险证据即不能 final release accepted" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#17365D;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="40" width="1500" height="70" as="geometry"/></mxCell>
        <mxCell id="p6_m1" value="M1 CLI&#xa;默认 shell 命令可执行&#xa;或 gap 明确阻断&#xa;不能只靠 parser inventory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="160" y="170" width="240" height="145" as="geometry"/></mxCell>
        <mxCell id="p6_m2" value="M2 Route A&#xa;真实资料 + 脱敏 + 截图/headless + 人工确认&#xa;缺项 needs_review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="460" y="170" width="240" height="145" as="geometry"/></mxCell>
        <mxCell id="p6_m3" value="M3 Quality&#xa;高风险 reviewer decision&#xa;低风险自动预审可复核&#xa;自动建议不能替代人工" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="760" y="170" width="240" height="145" as="geometry"/></mxCell>
        <mxCell id="p6_m4" value="M4 External&#xa;四个项目均有真实状态&#xa;缺路径 structured_unavailable&#xa;不可计 accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="1060" y="170" width="240" height="145" as="geometry"/></mxCell>
        <mxCell id="p6_m5" value="M5 Final Gate&#xa;runtime / Route A / Route B / Full Corpus / Quality / External / dependency / restore / human approval 全部满足才 accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="500" y="500" width="600" height="170" as="geometry"/></mxCell>
        <mxCell id="p6_user" value="用户能体验到的达成效果&#xa;1. 一眼看到当前是否能出门&#xa;2. 每个阻断项都有补证路径&#xa;3. Agent 可读取 evidence_refs 而不是猜测&#xa;4. 人类只处理高风险确认&#xa;5. 不可用项被结构化保留" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="130" y="520" width="330" height="220" as="geometry"/></mxCell>
        <mxCell id="p6_block" value="禁止通过&#xa;文档 claim 当 code fact&#xa;服务启动当测试通过&#xa;展示图当验收证据&#xa;unresolved 写 accepted&#xa;未授权改 legacy 大文件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="1140" y="520" width="330" height="220" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2_96_100_07" name="07 No-Go 与 false-green 风险">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p7_title" value="No-Go 与 false-green 风险：少人工不等于零人工，不等于放宽 accepted 门槛" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#17365D;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="40" width="1500" height="70" as="geometry"/></mxCell>
        <mxCell id="p7_nogo" value="No-Go&#xa;完整设计意图恢复&#xa;full call graph&#xa;runtime topology&#xa;data/control flow&#xa;type inference&#xa;docs claim = code fact&#xa;unresolved = accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=17;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="90" y="180" width="380" height="360" as="geometry"/></mxCell>
        <mxCell id="p7_false" value="False-green 场景&#xa;默认 CLI 未复验但写 accepted&#xa;Route A 缺真实资料但 accepted&#xa;Quality 缺人工 decision 但 accepted&#xa;External 缺路径但 accepted&#xa;docs/present 图替代验收证据&#xa;服务启动替代 restore smoke" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=17;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="610" y="180" width="410" height="360" as="geometry"/></mxCell>
        <mxCell id="p7_control" value="控制策略&#xa;每个 accepted 绑定 artifact_refs / evidence_refs&#xa;Release Gate 使用最差高风险状态&#xa;read 接口只读 persisted artifacts&#xa;high-risk 保留人类确认&#xa;structured_unavailable 不计 accepted&#xa;protected legacy diff 必查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=17;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="1160" y="180" width="360" height="360" as="geometry"/></mxCell>
        <mxCell id="p7_outcome" value="最终原则：本阶段目标是减少人工验收负担，让机器自动收集、分类、复跑和汇总证据；但高风险证据缺失时必须明确阻断，而不是自动放行。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#172033;fontColor=#FFFFFF;strokeColor=#172033;fontSize=20;fontStyle=1;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="170" y="680" width="1260" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
