        <mxCell id="p1_title" value="V2.96-V2.100 阶段目标：少人工真实验收与出门证据闭环" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#17365D;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="40" width="1500" height="70" as="geometry"/></mxCell>
        <mxCell id="p1_legend" value="颜色：绿色=已实现并测试；蓝色=已实现的新阶段实体；黄色=受限完成 / 需人工最小确认；红色=阻断或禁止；灰色=外部环境 / 展示材料" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="135" width="1440" height="55" as="geometry"/></mxCell>
        <mxCell id="p1_current" value="当前事实&#xa;V2.96-V2.100 focused tests 通过&#xa;Default CLI code 入口已补齐&#xa;automated-evidence-closure 已实现&#xa;Route A = needs_review&#xa;Quality = needs_review&#xa;External = structured_unavailable&#xa;Release Gate = structured_unavailable&#xa;docs/present 仅为理解材料" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="80" y="230" width="420" height="310" as="geometry"/></mxCell>
        <mxCell id="p1_target" value="目标体验&#xa;维护者少读长文档也能判断状态&#xa;Agent 可通过证据 refs 读取项目事实&#xa;Route A 自动生成证据包&#xa;质量建议形成最小人工队列&#xa;外部项目路径可治理&#xa;Release Gate 自动给出出门或阻断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="590" y="230" width="420" height="310" as="geometry"/></mxCell>
        <mxCell id="p1_boundary" value="验收边界&#xa;不声明 final release 已通过&#xa;不声明完整设计意图恢复&#xa;不声明 full call graph / runtime topology&#xa;缺真实资料不能 accepted&#xa;缺人工决策不能 accepted&#xa;展示图不能作为验收证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="1100" y="230" width="420" height="310" as="geometry"/></mxCell>
