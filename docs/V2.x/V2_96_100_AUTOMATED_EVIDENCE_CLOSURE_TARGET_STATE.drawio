        <mxCell id="p2_outcome" value="完成后的目标体验：系统自动收集可复跑证据，人类只确认 Route A、质量高风险、外部不可用、最终发布批准等高风险节点。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=17;fontStyle=1;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="220" y="680" width="1160" height="110" as="geometry"/></mxCell>
