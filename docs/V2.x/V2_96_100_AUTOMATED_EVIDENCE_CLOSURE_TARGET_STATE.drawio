        <mxCell id="p1_flow2" value="防假验收" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#B85450;" edge="1" parent="1" source="p1_target" target="p1_boundary"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_v96" value="V2.96&#xa;CLI gap closure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="650" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="p1_v97" value="V2.97&#xa;Route A evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="405" y="650" width="230" height="90" as="geometry"/></mxCell>
