        <mxCell id="p5_title" value="V2.96-V2.100 开发及验收计划：每阶段结束都要真实 E2E、PRD 检视、false-green 审计" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#17365D;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="40" width="1500" height="70" as="geometry"/></mxCell>
        <mxCell id="p5_v96" value="V2.96 CLI&#xa;输出：cli_surface_result / report&#xa;体验：默认命令可复核&#xa;验收：CLI/MCP/HTTP parity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="280" height="180" as="geometry"/></mxCell>
        <mxCell id="p5_v97" value="V2.97 Route A&#xa;输出：material_scan / redaction_audit / evidence_capture / manual_queue&#xa;体验：真实资料自动形成证据包" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="370" y="180" width="280" height="180" as="geometry"/></mxCell>
        <mxCell id="p5_v98" value="V2.98 Quality&#xa;输出：risk_queue / recommendations / backlog&#xa;体验：人类只处理高风险和证据不足项" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="670" y="180" width="280" height="180" as="geometry"/></mxCell>
        <mxCell id="p5_v99" value="V2.99 External&#xa;输出：project_paths / smoke_matrix / unavailable_resolution&#xa;体验：外部项目状态可复核" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="970" y="180" width="280" height="180" as="geometry"/></mxCell>
        <mxCell id="p5_v100" value="V2.100 Gate&#xa;输出：evidence_summary / final_release_gate / false_green_recheck&#xa;体验：最终出门或明确阻断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="1270" y="180" width="280" height="180" as="geometry"/></mxCell>
        <mxCell id="p5_entry" value="每阶段开始前&#xa;development plan&#xa;acceptance plan&#xa;pre-implementation audit&#xa;fatal/major = none 才能实现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="170" y="520" width="430" height="190" as="geometry"/></mxCell>
        <mxCell id="p5_exit" value="每阶段结束后&#xa;focused tests&#xa;real workspace E2E&#xa;PRD/spec review&#xa;false-green audit&#xa;acceptance audit report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="980" y="520" width="430" height="190" as="geometry"/></mxCell>
        <mxCell id="p5_reject" value="打回条件&#xa;缺真实资料却 accepted&#xa;缺 reviewer decision 却 accepted&#xa;缺路径却 accepted&#xa;展示图当作验收证据&#xa;默认 CLI gap 被隐藏" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="620" y="500" width="340" height="230" as="geometry"/></mxCell>
