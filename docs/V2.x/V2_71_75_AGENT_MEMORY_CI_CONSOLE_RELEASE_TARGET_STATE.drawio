  <diagram id="v2_71_75_04" name="04 证据流与状态规则">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="t4" value="证据流与状态规则：真实数据 → artifact/evidence → 状态 → 用户可见结论" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#17365D;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="40" width="1500" height="70" as="geometry" /></mxCell>
        <mxCell id="src4" value="真实输入&#xa;当前 data_service repo&#xa;外部项目真实路径（如存在）&#xa;pytest / compileall / git diff 输出&#xa;adapter registry inspection&#xa;persisted V2 artifacts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="80" y="210" width="300" height="260" as="geometry" /></mxCell>
        <mxCell id="process4" value="处理层（待新增）&#xa;External Closure&#xa;CI Governance&#xa;Agent Memory&#xa;Interactive Console&#xa;Release Restore" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="500" y="210" width="300" height="260" as="geometry" /></mxCell>
        <mxCell id="artifact4" value="输出 artifact&#xa;artifact_refs&#xa;evidence_refs&#xa;warnings&#xa;unresolved&#xa;next_actions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="920" y="210" width="300" height="260" as="geometry" /></mxCell>
        <mxCell id="status4" value="状态规则&#xa;accepted：真实证据齐全&#xa;needs_review：证据弱或需人工判断&#xa;structured_unavailable：外部条件不可用&#xa;structured_blocker：阻断需处理&#xa;out_of_scope：明确不属于阶段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="500" y="600" width="720" height="190" as="geometry" /></mxCell>
        <mxCell id="risk4" value="禁止转换（风险）&#xa;structured_unavailable → accepted&#xa;documentation claim → code fact&#xa;impact candidate → runtime call&#xa;mock-only evidence → real E2E accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;fontStyle=1;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="80" y="600" width="300" height="190" as="geometry" /></mxCell>
        <mxCell id="c1" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="src4" target="process4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="process4" target="artifact4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c3" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="artifact4" target="status4"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2_71_75_05" name="05 开发与验收计划">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="t5" value="开发与验收计划：每阶段必须有用户可见效果、focused tests、真实数据 E2E、PRD/spec review" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#17365D;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="40" width="1500" height="70" as="geometry" /></mxCell>
        <mxCell id="row1" value="V2.71 外部项目闭环&#xa;开发输出：project_binding_closure.json、e2e_closure_report.md&#xa;体验：维护者知道每个项目为何 accepted / unavailable / blocked&#xa;验收：data_service 真实 E2E；外部项目无路径不得 accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="1420" height="120" as="geometry" /></mxCell>
        <mxCell id="row2" value="V2.72 CI 与 warning 治理&#xa;开发输出：ci_matrix.json、warning_budget.json、failure_diagnosis.json、ci_readiness_report.md&#xa;体验：维护者知道慢测试、warning 风险和失败归因&#xa;验收：warning 超预算不能 accepted；public surface guard 保留" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="300" width="1420" height="120" as="geometry" /></mxCell>
        <mxCell id="row3" value="V2.73 Agent 长期记忆&#xa;开发输出：memory_index.json、evidence_index.json、acceptance_state.json、task_briefing.json、retention_policy.md&#xa;体验：Agent 能长期读取项目情报和证据边界&#xa;验收：所有 recommendation 有 evidence 或 needs_review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="450" width="1420" height="120" as="geometry" /></mxCell>
        <mxCell id="row4" value="V2.74 交互式维护者控制台&#xa;开发输出：console_model.json、navigation_model.json、status_panels.json、maintainer_console.html&#xa;体验：一页看清状态、风险、证据和下一步&#xa;验收：每个面板有 artifact/evidence/unresolved；不隐藏 non-accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="600" width="1420" height="120" as="geometry" /></mxCell>
        <mxCell id="row5" value="V2.75 发布与恢复打包&#xa;开发输出：release_manifest.json、mcp_config_template.json、smoke_commands.md、restore_runbook.md、release_readiness_report.md&#xa;体验：维护者能配置 MCP、运行 smoke、恢复本地能力&#xa;验收：redaction pass；smoke 覆盖 MCP / CLI / HTTP / focused tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="750" width="1420" height="120" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2_71_75_06" name="06 项目里程碑与出门条件">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="t6" value="里程碑与出门条件：没有审计闭环不得进入实现；验收失败必须回到开发计划" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#17365D;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="40" width="1500" height="70" as="geometry" /></mxCell>
        <mxCell id="entry6" value="进入条件&#xa;phase-specific development plan&#xa;acceptance plan&#xa;pre-implementation audit&#xa;PRD/spec review&#xa;protected legacy file strategy&#xa;false-green risk checklist&#xa;真实数据验收策略" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="80" y="170" width="420" height="300" as="geometry" /></mxCell>
        <mxCell id="milestone6" value="里程碑&#xa;M1 外部项目闭环&#xa;M2 CI/warning 治理&#xa;M3 Agent 长期记忆&#xa;M4 交互式控制台&#xa;M5 发布恢复打包" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;fontStyle=1;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="590" y="170" width="420" height="300" as="geometry" /></mxCell>
        <mxCell id="exit6" value="出门条件&#xa;focused tests passed&#xa;真实 data_service E2E&#xa;外部项目 accepted 或 structured unavailable/blocker&#xa;PRD/spec review&#xa;false-green audit&#xa;acceptance audit report&#xa;public surface guard&#xa;protected legacy diff check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="1100" y="170" width="420" height="300" as="geometry" /></mxCell>
        <mxCell id="block6" value="必须停止并回到计划&#xa;验收不通过且无结构化 blocker&#xa;把 unavailable 写 accepted&#xa;mock-only evidence 证明外部项目&#xa;控制台隐藏 non-accepted&#xa;public artifact 泄露路径或 token&#xa;需要改 protected legacy 但无批准" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;fontStyle=1;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="330" y="600" width="940" height="230" as="geometry" /></mxCell>
        <mxCell id="d1" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="entry6" target="milestone6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d2" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="milestone6" target="exit6"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2_71_75_07" name="07 验收门槛与目标能力">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="t7" value="验收门槛与目标能力：用户看到的能力必须由真实 artifact 和证据支撑" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#17365D;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="40" width="1500" height="70" as="geometry" /></mxCell>
        <mxCell id="cap1" value="目标能力 1：外部项目状态可信&#xa;用户体验：知道哪些项目能用、哪些不能用、为什么不能用&#xa;门槛：accepted 必须有真实路径、真实 E2E、artifact_ref、evidence_ref" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="160" width="680" height="140" as="geometry" /></mxCell>
        <mxCell id="cap2" value="目标能力 2：CI 风险可治理&#xa;用户体验：知道慢测试、warning、失败归因和下一步&#xa;门槛：warning budget、failure diagnosis、public surface guard 均有证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="830" y="160" width="680" height="140" as="geometry" /></mxCell>
        <mxCell id="cap3" value="目标能力 3：Agent 项目长期记忆可读&#xa;用户体验：Agent 读取项目情报、证据边界、验收状态、stop conditions&#xa;门槛：memory item 必须引用 persisted artifact；无证据进入 needs_review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="350" width="680" height="140" as="geometry" /></mxCell>
        <mxCell id="cap4" value="目标能力 4：维护者首页可操作&#xa;用户体验：一页看到状态、风险、证据、下一步、出门条件&#xa;门槛：每个 panel 有 status、artifact_ref、evidence_ref 或 unresolved reason" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="830" y="350" width="680" height="140" as="geometry" /></mxCell>
        <mxCell id="cap5" value="目标能力 5：发布恢复可执行&#xa;用户体验：按 runbook 配置 MCP、运行 smoke、恢复本地能力&#xa;门槛：release manifest、MCP config template、smoke commands、restore runbook、redaction pass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="540" width="680" height="140" as="geometry" /></mxCell>
        <mxCell id="cap6" value="最终拒绝门槛&#xa;不能隐藏 unavailable / blocker / needs_review&#xa;不能用 mock-only evidence 验收外部项目&#xa;不能泄露本地路径、secret、token、raw traceback&#xa;不能改 protected legacy 文件，除非用户明确批准" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=15;fontStyle=1;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="830" y="540" width="680" height="140" as="geometry" /></mxCell>
        <mxCell id="final7" value="最终阶段验收包必须包含：focused tests、真实 data_service E2E、外部项目结构化状态、PRD/spec review、false-green audit、public surface guard、protected legacy diff check、final acceptance audit report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="780" width="1160" height="100" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
