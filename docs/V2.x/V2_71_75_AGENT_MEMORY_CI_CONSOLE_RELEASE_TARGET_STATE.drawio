<mxfile host="Electron" agent="Codex" pages="7">
  <diagram id="v2_71_75_01" name="01 阶段目标与目标体验">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="V2.71-V2.75 阶段目标：外部项目闭环、CI 治理、Agent 长期记忆、维护者控制台、发布恢复" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#17365D;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="40" width="1500" height="70" as="geometry" /></mxCell>
        <mxCell id="legend1" value="颜色说明：绿色=已实现复用；蓝色=本阶段待新增；黄色=需增强/人工审查；红色=禁止或风险；灰色=外部依赖/结构化不可用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="1440" height="50" as="geometry" /></mxCell>
        <mxCell id="base1" value="当前基线（已实现复用）&#xa;V2.0-V2.70 本地 data_service E2E 已通过&#xa;Portal / Dashboard / path binding / delivery / surface baseline 已有 artifact&#xa;外部项目 codexPat / HarnessOS / Navia 仍 structured_unavailable&#xa;warning 数量高、慢测试存在、发布恢复仍需产品化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="80" y="230" width="430" height="300" as="geometry" /></mxCell>
        <mxCell id="target1" value="目标体验（待新增）&#xa;维护者：一页看清项目状态、风险、下一步和出门条件&#xa;Agent：读取长期记忆、证据索引、验收状态和 stop conditions&#xa;审计者：追溯每个 accepted / unavailable / needs_review 的证据&#xa;发布者：按 runbook 配置 MCP、运行 smoke、恢复本地能力" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="585" y="230" width="430" height="300" as="geometry" /></mxCell>
        <mxCell id="reject1" value="明确拒绝（风险）&#xa;不声称完整恢复设计意图&#xa;不声称 full call graph / runtime topology / data-control flow / type inference&#xa;不把文档声明当代码事实&#xa;不把 structured_unavailable / needs_review 写成 accepted&#xa;不自动删除文件&#xa;不改 protected legacy 大文件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="1090" y="230" width="430" height="300" as="geometry" /></mxCell>
        <mxCell id="p71" value="V2.71&#xa;外部项目绑定闭环&#xa;真实路径 / E2E / 不可用原因" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="650" width="250" height="100" as="geometry" /></mxCell>
        <mxCell id="p72" value="V2.72&#xa;CI 与 warning 治理&#xa;分组 / budget / 失败归因" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="650" width="250" height="100" as="geometry" /></mxCell>
        <mxCell id="p73" value="V2.73&#xa;Agent 长期记忆&#xa;memory index / evidence index / acceptance state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="650" width="250" height="100" as="geometry" /></mxCell>
        <mxCell id="p74" value="V2.74&#xa;交互式维护者控制台&#xa;首页 / 面板 / 证据跳转" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="950" y="650" width="250" height="100" as="geometry" /></mxCell>
        <mxCell id="p75" value="V2.75&#xa;发布与恢复打包&#xa;MCP 模板 / smoke / runbook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1240" y="650" width="250" height="100" as="geometry" /></mxCell>
