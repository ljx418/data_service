        <mxCell id="layer1" value="Public Adapter 层（待新增）&#xa;MCP tools：knowledge_code_agent_memory_release_*_build/read&#xa;CLI：python -m data_service code agent-memory-release ...&#xa;HTTP：/api/workspaces/{workspace_id}/codebases/{codebase_id}/agent-memory-release/..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="120" y="150" width="1360" height="120" as="geometry" /></mxCell>
