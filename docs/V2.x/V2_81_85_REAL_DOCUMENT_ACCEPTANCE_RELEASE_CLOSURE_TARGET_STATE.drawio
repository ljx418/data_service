  <diagram id="v2_81_85_06" name="06 风险、needs_review 与 false-green 防线">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="p6_title" value="风险与 false-green 防线：所有未闭环状态必须可见，不能被 UI、报告或截图改写" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#17365D;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="40" width="1500" height="70" as="geometry" /></mxCell>
        <mxCell id="p6_r1" value="风险 1&#xa;思维导图方向 OK 被误写成真实资料 accepted&#xa;状态：needs_review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="90" y="190" width="400" height="150" as="geometry" /></mxCell>
        <mxCell id="p6_r2" value="风险 2&#xa;mock-only document 替代真实资料&#xa;处理：拒绝 accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;" vertex="1" parent="1"><mxGeometry x="600" y="190" width="400" height="150" as="geometry" /></mxCell>
        <mxCell id="p6_r3" value="风险 3&#xa;Source trace 缺失但检索结果 accepted&#xa;处理：needs_review / structured_blocker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1110" y="190" width="400" height="150" as="geometry" /></mxCell>
        <mxCell id="p6_r4" value="风险 4&#xa;GraphRAG 被描述为 full call graph / runtime topology&#xa;处理：禁止过度承诺" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;" vertex="1" parent="1"><mxGeometry x="90" y="460" width="400" height="150" as="geometry" /></mxCell>
        <mxCell id="p6_r5" value="风险 5&#xa;外部项目不可用却计入 accepted&#xa;处理：structured_unavailable 不计 accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;" vertex="1" parent="1"><mxGeometry x="600" y="460" width="400" height="150" as="geometry" /></mxCell>
        <mxCell id="p6_r6" value="风险 6&#xa;human approval 缺失但 release accepted&#xa;处理：final release not accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1110" y="460" width="400" height="150" as="geometry" /></mxCell>
        <mxCell id="p6_guard" value="统一防线&#xa;accepted 必须绑定：真实资料 + artifact refs + 截图证据 + 命令/API/CLI/MCP 结果 + PRD/spec review + false-green audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="730" width="1120" height="100" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2_81_85_07" name="07 开发及验收计划">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="p7_title" value="开发及验收计划：先完成文档基线，再进入真实资料补验或后续实现" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#17365D;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="40" width="1500" height="70" as="geometry" /></mxCell>
        <mxCell id="p7_doc" value="文档开发（当前执行）&#xa;PRD&#xa;目标架构&#xa;开发验收计划&#xa;里程碑 / 出门条件&#xa;gap / coverage / schema&#xa;drawio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="210" width="320" height="240" as="geometry" /></mxCell>
        <mxCell id="p7_audit" value="文档验收&#xa;术语一致&#xa;drawio 不超过 8 页&#xa;禁止过度承诺&#xa;needs_review 保留&#xa;JSON / diff check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;" vertex="1" parent="1"><mxGeometry x="500" y="210" width="320" height="240" as="geometry" /></mxCell>
        <mxCell id="p7_e2e" value="真实资料补验（下一步）&#xa;导入真实资料&#xa;build / Wiki&#xa;query / GraphRAG&#xa;Source trace&#xa;quality governance&#xa;截图 / artifact refs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="920" y="210" width="320" height="240" as="geometry" /></mxCell>
        <mxCell id="p7_release" value="出门复核&#xa;真实资料 accepted?&#xa;外部项目状态?&#xa;warning gate?&#xa;restore/smoke?&#xa;human approval?&#xa;final release status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="500" y="570" width="360" height="240" as="geometry" /></mxCell>
        <mxCell id="p7_stop" value="停止条件&#xa;真实资料缺失&#xa;Source trace 缺失&#xa;human approval 缺失&#xa;外部路径缺失&#xa;任何 false-green 风险" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1000" y="570" width="340" height="240" as="geometry" /></mxCell>
        <mxCell id="p7_e1" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="p7_doc" target="p7_audit"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p7_e2" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="p7_audit" target="p7_e2e"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p7_e3" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="p7_e2e" target="p7_release"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p7_e4" value="任一风险触发" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="p7_e2e" target="p7_stop"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2_81_85_08" name="08 里程碑、验收门槛与出门条件">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="p8_title" value="里程碑与出门条件：真实资料、外部项目、人工审批三类高风险项必须可见" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#17365D;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="40" width="1500" height="70" as="geometry" /></mxCell>
        <mxCell id="p8_m1" value="M1 V2.81&#xa;样本 contract&#xa;真实资料来源类型 / 脱敏 / 验收路径" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="170" width="280" height="120" as="geometry" /></mxCell>
        <mxCell id="p8_m2" value="M2 V2.82&#xa;真实资料导入与 Wiki&#xa;source refs / artifact refs / 截图" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="390" y="170" width="280" height="120" as="geometry" /></mxCell>
        <mxCell id="p8_m3" value="M3 V2.83&#xa;检索 / GraphRAG / Source trace&#xa;结果必须可追溯" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="710" y="170" width="280" height="120" as="geometry" /></mxCell>
        <mxCell id="p8_m4" value="M4 V2.84&#xa;质量治理 / 纠错&#xa;low signal 和 review 状态可见" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1030" y="170" width="280" height="120" as="geometry" /></mxCell>
        <mxCell id="p8_m5" value="M5 V2.85&#xa;Release closure rerun&#xa;真实资料 + 外部项目 + human approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="550" y="360" width="360" height="130" as="geometry" /></mxCell>
        <mxCell id="p8_gate" value="最终 accepted 门槛&#xa;真实资料人工验收 accepted&#xa;Source trace 可追溯&#xa;质量治理状态可审计&#xa;外部项目不可用不计 accepted&#xa;human approval 已记录&#xa;protected legacy 文件无 diff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="140" y="610" width="560" height="220" as="geometry" /></mxCell>
        <mxCell id="p8_block" value="必须阻断 / 打回&#xa;真实资料未使用&#xa;mock-only evidence&#xa;Source trace 缺失&#xa;GraphRAG 过度承诺&#xa;external unavailable 写 accepted&#xa;human approval 缺失却 release accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="610" width="560" height="220" as="geometry" /></mxCell>
        <mxCell id="p8_e1" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="p8_m1" target="p8_m2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p8_e2" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="p8_m2" target="p8_m3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p8_e3" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="p8_m3" target="p8_m4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p8_e4" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="p8_m4" target="p8_m5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p8_e5" value="满足全部门槛" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="p8_m5" target="p8_gate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p8_e6" value="任一缺失" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="p8_m5" target="p8_block"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
