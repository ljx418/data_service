        <mxCell id="p4_8" value="8 Release closure&#xa;真实资料 + 外部项目 + human approval&#xa;任一缺失 final release not accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1000" y="560" width="300" height="150" as="geometry" /></mxCell>
