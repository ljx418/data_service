        <mxCell id="p1_current" value="当前事实（已实现 + 未闭环）&#xa;V2.76-V2.80 自动化阶段验收已完成&#xa;思维导图/可视化方向基本 OK&#xa;人工验收未使用真实文档资料&#xa;真实资料人工验收 = needs_review&#xa;final release 仍不能 accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="80" y="240" width="430" height="280" as="geometry" /></mxCell>
        <mxCell id="p1_target" value="目标体验（待补验）&#xa;维护者导入真实文档资料&#xa;查看 Wiki artifact&#xa;执行检索 / GraphRAG&#xa;追溯 Source trace&#xa;查看质量治理 / 纠错状态&#xa;汇总 release readiness" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="585" y="240" width="430" height="280" as="geometry" /></mxCell>
        <mxCell id="p1_reject" value="明确拒绝（红线）&#xa;不把方向 OK 写成真实资料 accepted&#xa;不把 mock-only document 写成真实资料&#xa;不声称 full call graph / runtime topology&#xa;不绕过 external project path / human approval&#xa;不修改 protected legacy 文件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="1090" y="240" width="430" height="280" as="geometry" /></mxCell>
