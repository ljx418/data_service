  <diagram id="v2-106-110-01" name="01 阶段目标与目标体验"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="V2.106-V2.110：项目组合最终证据闭环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2937;fontColor=#ffffff;strokeColor=#111827;fontSize=24;" vertex="1" parent="1"><mxGeometry x="60" y="50" width="520" height="70" as="geometry"/></mxCell><mxCell id="goal" value="目标：把 V2.101-V2.105 未全绿项转成可复跑、可审计、可阻断的 final evidence closure。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=16;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="650" height="90" as="geometry"/></mxCell><mxCell id="maintainer" value="维护者体验&#xa;看到已实现、待补证、不可用和下一步动作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="330" height="110" as="geometry"/></mxCell><mxCell id="agent" value="Agent 体验&#xa;读取 build queue、source trace backlog、OCR gap，不制造无证据事实" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=15;" vertex="1" parent="1"><mxGeometry x="430" y="290" width="390" height="110" as="geometry"/></mxCell><mxCell id="auditor" value="审计者体验&#xa;复跑真实 workspace E2E，检查 accepted 是否有证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=15;" vertex="1" parent="1"><mxGeometry x="860" y="290" width="360" height="110" as="geometry"/></mxCell><mxCell id="no_claim" value="不声明：完整设计意图、full call graph、runtime topology、data/control flow、type inference、OCR 缺失媒体已理解。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="1160" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram>
