  <diagram id="v2-111-115-05" name="05 开发与验收计划"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p111" value="V2.111&#xa;开发：OCR 样本资格 + 真实 OCR/media execution&#xa;体验：看到每个媒体资料结果或阻断&#xa;验收：缺真实 OCR 样本或缺 provider 不 accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="260" height="150" as="geometry"/></mxCell><mxCell id="p112" value="V2.112&#xa;开发：source import/query/trace&#xa;体验：可追踪 accepted 文档证据链&#xa;验收：三段缺一不可 accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=15;" vertex="1" parent="1"><mxGeometry x="350" y="70" width="260" height="150" as="geometry"/></mxCell><mxCell id="p113" value="V2.113&#xa;开发：headless UI screenshot&#xa;体验：看到 /knowledge 真实截图&#xa;验收：截图 hash 或 browser blocker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=15;" vertex="1" parent="1"><mxGeometry x="640" y="70" width="260" height="150" as="geometry"/></mxCell><mxCell id="p114" value="V2.114&#xa;开发：safe multi-project runtime&#xa;体验：队列、缓存、超时、失败隔离&#xa;验收：未批准命令不执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=15;" vertex="1" parent="1"><mxGeometry x="930" y="70" width="260" height="150" as="geometry"/></mxCell><mxCell id="p115" value="V2.115&#xa;开发：final gate rerun/report&#xa;体验：明确最终能否出门&#xa;验收：高风险未闭合不得 accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1220" y="70" width="260" height="150" as="geometry"/></mxCell><mxCell id="tests" value="每阶段必须完成&#xa;development plan / acceptance plan / pre-implementation audit&#xa;focused tests&#xa;真实 E2E&#xa;PRD/spec review&#xa;false-green audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=16;" vertex="1" parent="1"><mxGeometry x="160" y="330" width="1160" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram>
  <diagram id="v2-111-115-06" name="06 里程碑与出门条件"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="m0" value="M0 文档出门&#xa;PRD/架构/计划/矩阵/测试/drawio 全部落盘&#xa;drawio ≤ 8 页中文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="330" height="120" as="geometry"/></mxCell><mxCell id="m1" value="M1-M4 子阶段出门&#xa;各自 artifacts 生成&#xa;真实 E2E 或 structured blocker&#xa;focused tests 通过" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=15;" vertex="1" parent="1"><mxGeometry x="470" y="60" width="330" height="120" as="geometry"/></mxCell><mxCell id="m5" value="M5 最终出门&#xa;final_acceptance_gate.json&#xa;false-green audit&#xa;HTML report&#xa;public surface guard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=15;" vertex="1" parent="1"><mxGeometry x="880" y="60" width="330" height="120" as="geometry"/></mxCell><mxCell id="exit" value="Final accepted 条件&#xa;所有高风险项 accepted 或 approved out_of_scope&#xa;无 blocked tests&#xa;无 protected legacy diff&#xa;报告不隐藏 non-accepted 状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=16;" vertex="1" parent="1"><mxGeometry x="180" y="280" width="900" height="150" as="geometry"/></mxCell><mxCell id="fail" value="任一出现即拒绝出门&#xa;OCR 样本资格/OCR/source trace/UI/build 高风险项未闭合&#xa;drawio 与实现状态不一致&#xa;promised artifact 缺失&#xa;测试或 public surface guard 阻塞" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=16;" vertex="1" parent="1"><mxGeometry x="180" y="500" width="900" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram>
  <diagram id="v2-111-115-07" name="07 No-Go 与风险"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="risk1" value="No-Go 1&#xa;OCR readiness、文件存在、直接文本抽取不能替代 OCR 样本资格和 OCR result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="70" width="330" height="100" as="geometry"/></mxCell><mxCell id="risk2" value="No-Go 2&#xa;文件存在不能替代 source import/query/source trace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=15;" vertex="1" parent="1"><mxGeometry x="460" y="70" width="330" height="100" as="geometry"/></mxCell><mxCell id="risk3" value="No-Go 3&#xa;HTML report 不能替代 UI screenshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=15;" vertex="1" parent="1"><mxGeometry x="840" y="70" width="330" height="100" as="geometry"/></mxCell><mxCell id="risk4" value="No-Go 4&#xa;有界 build 不能冒充全量 accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="230" width="330" height="100" as="geometry"/></mxCell><mxCell id="risk5" value="No-Go 5&#xa;未批准外部 shell command 不执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=15;" vertex="1" parent="1"><mxGeometry x="460" y="230" width="330" height="100" as="geometry"/></mxCell><mxCell id="risk6" value="No-Go 6&#xa;needs_review / unavailable / blocker 不计 accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=15;" vertex="1" parent="1"><mxGeometry x="840" y="230" width="330" height="100" as="geometry"/></mxCell><mxCell id="mitigation" value="风险闭环&#xa;run_id + input_hashes 防 mixed-run&#xa;allowlist + timeout + cache 控制 build&#xa;headless 优先，visible browser 前必须告知用户&#xa;所有 public artifact 做路径/secret/traceback 脱敏" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=16;" vertex="1" parent="1"><mxGeometry x="180" y="430" width="900" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
