<mxfile host="app.diagrams.net" modified="2026-07-13T00:00:00.000Z" agent="codex" version="24.7.17">
  <diagram id="v2-111-115-01" name="01 阶段目标与目标体验"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="V2.111-V2.115：项目组合最终验收闭环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2937;fontColor=#ffffff;strokeColor=#111827;fontSize=24;" vertex="1" parent="1"><mxGeometry x="60" y="50" width="560" height="70" as="geometry"/></mxCell><mxCell id="baseline" value="当前事实&#xa;implementation_status=accepted&#xa;portfolio_final_status=structured_unavailable&#xa;high_risk_unresolved_count=164" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=16;" vertex="1" parent="1"><mxGeometry x="660" y="50" width="470" height="130" as="geometry"/></mxCell><mxCell id="goal" value="阶段目标&#xa;把 OCR 样本资格、OCR 执行、source trace、UI 截图、多项目安全 build 的缺口转成真实执行证据或明确结构化阻断。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=16;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="560" height="110" as="geometry"/></mxCell><mxCell id="maintainer" value="维护者体验&#xa;在 /knowledge 或 HTML report 中看到最终出门状态、截图证据、OCR 样本资格、OCR/source trace/build 阻断原因和下一步动作。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="390" height="130" as="geometry"/></mxCell><mxCell id="agent" value="Agent 体验&#xa;读取完整 build queue、safe command、timeout/cache/retry 结果；不能把 unavailable 写成 accepted。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=15;" vertex="1" parent="1"><mxGeometry x="500" y="320" width="390" height="130" as="geometry"/></mxCell><mxCell id="auditor" value="审计者体验&#xa;复核每个 accepted 行是否具备 command/API/MCP/UI artifact、source refs、hash、PRD review、false-green audit。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=15;" vertex="1" parent="1"><mxGeometry x="940" y="320" width="390" height="130" as="geometry"/></mxCell><mxCell id="no_claim" value="边界&#xa;不声称 full call graph / runtime topology / data flow / control flow / type inference；不把 docs claim 当 code fact。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#6b7280;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="1270" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram>
  <diagram id="v2-111-115-02" name="02 当前架构到目标架构"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="legend1" value="绿色=已实现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="160" height="45" as="geometry"/></mxCell><mxCell id="legend2" value="蓝色=待新增" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=14;" vertex="1" parent="1"><mxGeometry x="240" y="40" width="160" height="45" as="geometry"/></mxCell><mxCell id="legend3" value="黄色=需修改/增强" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=14;" vertex="1" parent="1"><mxGeometry x="420" y="40" width="180" height="45" as="geometry"/></mxCell><mxCell id="legend4" value="红色=No-Go" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=14;" vertex="1" parent="1"><mxGeometry x="620" y="40" width="150" height="45" as="geometry"/></mxCell><mxCell id="current" value="当前已实现&#xa;workspace_portfolio/service.py&#xa;workspace_portfolio_final_evidence/service.py&#xa;CLI/MCP/HTTP final evidence&#xa;/knowledge final evidence panel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="150" width="390" height="190" as="geometry"/></mxCell><mxCell id="gap" value="当前缺口&#xa;OCR 真实样本资格与执行缺失&#xa;source import/query/trace 缺失&#xa;UI 截图缺失&#xa;safe multi-project runtime 缺失&#xa;final release 非 accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=15;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="390" height="190" as="geometry"/></mxCell><mxCell id="target" value="目标新增&#xa;Media Execution Provider&#xa;Source Trace Closure Runner&#xa;Headless UI Evidence Runner&#xa;Safe Project Build Runtime&#xa;Final Acceptance Rerun Gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1040" y="150" width="390" height="190" as="geometry"/></mxCell><mxCell id="edge1" value="读取 V2.106-V2.110 artifacts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#2563eb;" edge="1" parent="1" source="current" target="gap"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge2" value="补真实执行证据" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#2563eb;" edge="1" parent="1" source="gap" target="target"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nogo" value="No-Go&#xa;不自动修改被扫描项目&#xa;不执行未批准外部 build script&#xa;不把 unavailable/needs_review 计入 accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="430" width="1350" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram>
  <diagram id="v2-111-115-03" name="03 代码实体分层关系"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="entry" value="用户入口层&#xa;/knowledge&#xa;HTML report&#xa;CLI portfolio-final-acceptance&#xa;MCP final_acceptance_*&#xa;HTTP /portfolio-final-acceptance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="320" height="190" as="geometry"/></mxCell><mxCell id="orch" value="编排层：待新增&#xa;workspace_portfolio_final_acceptance/service.py&#xa;plan/build/read/report&#xa;run lineage&#xa;artifact aggregation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=15;" vertex="1" parent="1"><mxGeometry x="470" y="60" width="360" height="190" as="geometry"/></mxCell><mxCell id="exec" value="执行适配层：待新增&#xa;media_execution.py&#xa;source_trace.py&#xa;ui_evidence.py&#xa;build_runtime.py&#xa;release_gate.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=15;" vertex="1" parent="1"><mxGeometry x="920" y="60" width="360" height="190" as="geometry"/></mxCell><mxCell id="existing" value="已有能力层：已实现/只读复用&#xa;workspace_portfolio&#xa;workspace_portfolio_final_evidence&#xa;source registry / query / source trace&#xa;code assets registry / snapshot / inventory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=15;" vertex="1" parent="1"><mxGeometry x="180" y="340" width="440" height="180" as="geometry"/></mxCell><mxCell id="persist" value="持久化层&#xa;portfolio_final_evidence/* 已有&#xa;portfolio_final_acceptance/* 待新增&#xa;所有 public output 含 schema_version、run_id、artifact_refs、evidence_refs、unresolved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=15;" vertex="1" parent="1"><mxGeometry x="740" y="340" width="500" height="180" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2563eb;" edge="1" parent="1" source="entry" target="orch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2563eb;" edge="1" parent="1" source="orch" target="exec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#16a34a;" edge="1" parent="1" source="exec" target="existing"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#d97706;" edge="1" parent="1" source="orch" target="persist"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
  <diagram id="v2-111-115-04" name="04 数据流与证据流"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="input" value="输入基线&#xa;/mnt/c/workspace&#xa;v2_106_110_real/portfolio_final_evidence/*&#xa;V2.111-V2.115 docs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#6b7280;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="340" height="140" as="geometry"/></mxCell><mxCell id="media" value="V2.111 Media Evidence&#xa;OCR 样本资格 → OCR / PDF / PPT / image 执行&#xa;provider result 或 structured_unavailable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=15;" vertex="1" parent="1"><mxGeometry x="500" y="40" width="330" height="110" as="geometry"/></mxCell><mxCell id="trace" value="V2.112 Source Trace&#xa;source import -> query -> source trace refs&#xa;缺一不可 accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=15;" vertex="1" parent="1"><mxGeometry x="500" y="190" width="330" height="110" as="geometry"/></mxCell><mxCell id="ui" value="V2.113 UI Evidence&#xa;headless screenshot hash&#xa;browser blocker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=15;" vertex="1" parent="1"><mxGeometry x="500" y="340" width="330" height="110" as="geometry"/></mxCell><mxCell id="build" value="V2.114 Safe Build&#xa;allowlist / timeout / cache / retry&#xa;未执行不 accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=15;" vertex="1" parent="1"><mxGeometry x="500" y="490" width="330" height="110" as="geometry"/></mxCell><mxCell id="gate" value="V2.115 Final Gate&#xa;聚合所有证据&#xa;accepted 或可信 non-accepted&#xa;输出 report + false-green audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a3