  <diagram id="v25962-05-milestones" name="05 里程碑与出门条件">
    <mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p5-title" value="项目里程碑与出门条件" style="text;html=1;fontSize=32;fontStyle=1;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="1200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5-m0" value="M0 阶段准备&#xa;• V2.54-V2.58 已接受&#xa;• 本阶段文档齐全&#xa;• 无致命/重大规划发现" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#f8fafc;strokeColor=#475569;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="190" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p5-m1" value="M1 V2.59&#xa;合同稳定出门&#xa;• 合同快照&#xa;• 一致性矩阵&#xa;• 漂移报告&#xa;• 迁移说明&#xa;• 守护测试 + 真实 E2E" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#eff6ff;strokeColor=#2563eb;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="190" width="300" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p5-m2" value="M2 V2.60&#xa;真实 E2E 出门&#xa;• data_service 已接受&#xa;• 外部项目有真实结果或结构化原因&#xa;• 不可用不计已接受&#xa;• mock-only 拒绝" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#f0fdf4;strokeColor=#16a34a;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="780" y="190" width="300" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p5-m3" value="M3 V2.61&#xa;交付整理出门&#xa;• package manifest&#xa;• cleanup plan&#xa;• handoff checklist&#xa;• package audit&#xa;• 不自动删除未知文件" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#fff7ed;strokeColor=#ea580c;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1130" y="190" width="300" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p5-m4" value="M4 V2.62&#xa;门户集成出门&#xa;• 状态摘要&#xa;• 页面分区&#xa;• 验收面板&#xa;• portal_v3.html&#xa;• 状态不混淆" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#fdf2f8;strokeColor=#db2777;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1480" y="190" width="300" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p5-m5" value="M5 总阶段收口&#xa;• 覆盖矩阵回填&#xa;• 基线回归&#xa;• 专项测试&#xa;• 真实 E2E / 结构化理由&#xa;• PRD/规格检视&#xa;• 虚假通过审计&#xa;• 受保护 diff 为空" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;fillColor=#eef2ff;strokeColor=#4f46e5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1830" y="190" width="300" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p5-reject" value="全局打回规则&#xa;1. 使用 mock-only evidence 作为真实 E2E。&#xa;2. 结构化不可用被写成已接受。&#xa;3. 门户隐藏未解决项或待审查项。&#xa;4. 清理动作删除未确认用户文件。&#xa;5. 文档声明被当作代码事实。&#xa;6. 声称完整调用图、运行时拓扑、数据/控制流或类型推断。" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#fef2f2;strokeColor=#dc2626;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="250" y="720" width="1700" height="230" as="geometry" />
        </mxCell>
        <mxCell id="p5-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="p5-m0" target="p5-m1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="p5-m1" target="p5-m2">
