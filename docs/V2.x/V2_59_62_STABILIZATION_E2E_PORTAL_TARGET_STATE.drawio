<mxfile host="Electron" agent="Codex" pages="6">
  <diagram id="v25962-01-experience" name="01 目标体验与阶段边界">
    <mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1-title" value="V2.59-V2.62 目标体验与阶段边界" style="text;html=1;fontSize=32;fontStyle=1;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="1300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p1-current" value="当前已验收基础&#xa;V2.54-V2.58 人机协作加深&#xa;&#xa;已具备：&#xa;• 人类门户加深&#xa;• 智能体任务工作流&#xa;• 文档-代码证据闭环&#xa;• 多项目回归验收&#xa;• 恢复体验&#xa;• 专项测试与真实 E2E 证据" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ecfdf5;strokeColor=#059669;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="80" y="150" width="520" height="360" as="geometry" />
        </mxCell>
        <mxCell id="p1-gap" value="本阶段要补的交付缺口&#xa;&#xa;1. 公开接口有测试守护，但缺少合同快照与迁移说明。&#xa;2. HarnessOS / Navia 仍可能是结构化不可用。&#xa;3. 工作树含临时目录、测试依赖、脚本、文档，缺少交付清单。&#xa;4. 人类门户尚未统一展示合同稳定、真实 E2E、恢复状态、交付状态。" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="840" y="150" width="520" height="360" as="geometry" />
        </mxCell>
        <mxCell id="p1-target" value="目标体验&#xa;&#xa;维护者打开人类门户或验收摘要后，可以快速回答：&#xa;• 对外能力是否稳定&#xa;• 哪些接口有漂移&#xa;• 四项目 E2E 覆盖到哪里&#xa;• 失败属于哪类&#xa;• 哪些文件应提交或清理&#xa;• 下一步动作和出门条件是什么" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#eff6ff;strokeColor=#2563eb;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1600" y="150" width="520" height="360" as="geometry" />
        </mxCell>
        <mxCell id="p1-human" value="人类维护者&#xa;看稳定状态、E2E 覆盖、交付清单、下一步动作" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;fillColor=#eef2ff;strokeColor=#4f46e5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="210" y="690" width="430" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1-agent" value="Coding Agent&#xa;读合同快照、影响检查、必跑测试、停止条件" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;fillColor=#f0fdf4;strokeColor=#16a34a;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="690" width="430" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1-auditor" value="架构审计者&#xa;查接口一致性、漂移、真实 E2E、清理安全、门户状态渲染" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;fillColor=#fff7ed;strokeColor=#ea580c;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1190" y="690" width="430" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1-newcomer" value="新接手者&#xa;按 handoff checklist 恢复验收并定位失败原因" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;fillColor=#fdf2f8;strokeColor=#db2777;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1680" y="690" width="360" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1-boundary" value="硬边界&#xa;不声称完整设计意图恢复；不声称完整调用图、运行时拓扑、数据/控制流或类型推断；不把文档声明当作代码事实；不把待审查、结构化不可用、结构化阻断写成已接受；不自动删除未确认归属文件；不修改受保护 legacy 大文件。" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#fef2f2;strokeColor=#dc2626;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="220" y="1010" width="1760" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p1-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="p1-current" target="p1-gap">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="p1-gap" target="p1-target">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v25962-02-architecture-diff" name="02 当前架构到目标架构">
    <mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2-title" value="当前架构与目标架构的关联关系" style="text;html=1;fontSize=32;fontStyle=1;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="1300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-current" value="当前实现实体&#xa;&#xa;服务层：human_agent_deepening/&#xa;• human_portal.py&#xa;• task_workflow.py&#xa;• evidence_loop.py&#xa;• regression.py&#xa;• restore_ux.py&#xa;• persistence.py / shared.py&#xa;&#xa;出口：MCP、CLI、HTTP&#xa;守护：专项测试、公开接口守护测试&#xa;证据：V2.54-V2.58 审计报告 / 覆盖矩阵" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#ecfdf5;strokeColor=#059669;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="70" y="160" width="500" height="470" as="geometry" />
        </mxCell>
        <mxCell id="p2-v259" value="V2.59 新增实体&#xa;公开接口合同登记器&#xa;&#xa;读取：MCP/CLI/HTTP 注册表&#xa;输出：合同快照、一致性矩阵、漂移报告、迁移说明&#xa;效果：知道接口是否稳定、哪里变了、如何迁移" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#eff6ff;strokeColor=#2563eb;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="720" y="120" width="500" height="250" as="geometry" />
        </mxCell>
        <mxCell id="p2-v260" value="V2.60 新增实体&#xa;真实项目 E2E 扩展运行器&#xa;&#xa;读取：真实仓库、既有 artifacts、验收命令&#xa;输出：项目矩阵、失败诊断、产物可用性&#xa;效果：区分已接受、结构化不可用、结构化阻断" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#f0fdf4;strokeColor=#16a34a;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="720" y="440" width="500" height="250" as="geometry" />
        </mxCell>
        <mxCell id="p2-v261" value="V2.61 新增实体&#xa;验收交付包管理器&#xa;&#xa;读取：工作树、测试依赖、脚本、文档、验收产物&#xa;输出：交付清单、清理计划、交接清单、交付审计&#xa;效果：明确提交边界和恢复路径" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#fff7ed;strokeColor=#ea580c;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1450" y="120" width="560" height="250" as="geometry" />
        </mxCell>
        <mxCell id="p2-v262" value="V2.62 新增实体&#xa;人类门户集成层&#xa;&#xa;读取：V2.54-V2.61 持久化产物&#xa;输出：门户状态摘要、页面分区、验收面板、project_portal_v3.html&#xa;效果：一屏呈现稳定性、E2E、恢复、交付状态" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#fdf2f8;strokeColor=#db2777;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1450" y="440" width="560" height="250" as="geometry" />
        </mxCell>
        <mxCell id="p2-target" value="目标架构结果&#xa;现有能力不重写；新增稳定交付层围绕已验收服务工作：合同稳定、真实 E2E、交付清理、门户集成。所有已接受结论都必须有产物路径、专项测试、真实 E2E 或结构化理由。" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#eef2ff;strokeColor=#4f46e5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="310" y="900" width="1580" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p2-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2563eb;strokeWidth=2;" edge="1" parent="1" source="p2-current" target="p2-v259">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#16a34a;strokeWidth=2;" edge="1" parent="1" source="p2-current" target="p2-v260">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#ea580c;strokeWidth=2;" edge="1" parent="1" source="p2-v259" target="p2-v261">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#db2777;strokeWidth=2;" edge="1" parent="1" source="p2-v260" target="p2-v262">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="p2-v261" target="p2-target">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="p2-v262" target="p2-target">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
