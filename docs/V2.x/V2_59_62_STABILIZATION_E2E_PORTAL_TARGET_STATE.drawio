  <diagram id="v25962-04-plan" name="04 开发与验收计划">
    <mxGraphModel dx="2066" dy="1053" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p4-title" parent="1" style="text;html=1;fontSize=32;fontStyle=1;strokeColor=none;fillColor=none;align=left;" value="开发与验收计划：每阶段先审计，后实现，再验收" vertex="1">
          <mxGeometry height="60" width="1500" x="60" y="40" as="geometry" />
        </mxCell>
        <mxCell id="p4-gate" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;fillColor=#fef2f2;strokeColor=#dc2626;align=left;verticalAlign=top;spacing=14;" value="阶段开始前固定门禁&#xa;1. phase development plan&#xa;2. phase acceptance plan&#xa;3. pre-implementation audit&#xa;4. 关闭 fatal / major finding&#xa;5. 确认可用真实项目和不可用结构化规则" vertex="1">
          <mxGeometry height="300" width="420" x="70" y="160" as="geometry" />
        </mxCell>
        <mxCell id="p4-v259" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#eff6ff;strokeColor=#2563eb;align=left;verticalAlign=top;spacing=14;" value="V2.59&#xa;公开接口稳定化&#xa;&#xa;完成后体验：&#xa;维护者看到接口是否稳定；Agent 获得合同快照；审计者看到漂移与迁移说明。&#xa;&#xa;验收：快照、一致性、漂移、迁移说明、守护测试、真实 data_service E2E。" vertex="1">
          <mxGeometry height="380" width="360" x="610" y="130" as="geometry" />
        </mxCell>
        <mxCell id="p4-v260" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#f0fdf4;strokeColor=#16a34a;align=left;verticalAlign=top;spacing=14;" value="V2.60&#xa;真实项目 E2E 扩展&#xa;&#xa;完成后体验：&#xa;维护者看到四项目验收状态和失败分类；不可用项目有复查动作。&#xa;&#xa;验收：data_service 已接受；外部项目已接受或有结构化理由；mock-only 拒绝。" vertex="1">
          <mxGeometry height="380" width="360" x="1040" y="130" as="geometry" />
        </mxCell>
        <mxCell id="p4-v261" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#fff7ed;strokeColor=#ea580c;align=left;verticalAlign=top;spacing=14;" value="V2.61&#xa;Acceptance Packaging&#xa;&#xa;完成后体验：&#xa;维护者知道哪些文件应提交、哪些是临时产物；新接手者按 checklist 恢复。&#xa;&#xa;验收：manifest、cleanup plan、handoff、redaction、无自动删除。" vertex="1">
          <mxGeometry height="380" width="360" x="1470" y="130" as="geometry" />
        </mxCell>
        <mxCell id="p4-v262" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#fdf2f8;strokeColor=#db2777;align=left;verticalAlign=top;spacing=14;" value="V2.62&#xa;人类门户体验集成&#xa;&#xa;完成后体验：&#xa;门户一屏展示稳定性、E2E、恢复、交付、下一步动作。&#xa;&#xa;验收：只读持久化产物、状态不混淆、HTML 烟测、PRD 检视、虚假通过审计。" vertex="1">
          <mxGeometry height="370" width="360" x="1470" y="560" as="geometry" />
        </mxCell>
        <mxCell id="p4-close" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#eef2ff;strokeColor=#4f46e5;align=left;verticalAlign=top;spacing=16;" value="总阶段收口&#xa;&#xa;• V2.46-V2.58 基线回归&#xa;• V2.59-V2.62 专项测试&#xa;• 公开接口守护测试&#xa;• 真实 E2E / 结构化理由&#xa;• compileall、diff check、受保护 diff&#xa;• PRD/规格检视、虚假通过审计、验收审计" vertex="1">
