  <diagram id="v25962-06-acceptance" name="06 验收门槛与目标能力">
    <mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p6-title" value="验收门槛：用户能体验到什么，项目能达成什么" style="text;html=1;fontSize=32;fontStyle=1;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="1500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p6-user" value="用户可感知功能&#xa;&#xa;• 门户显示合同稳定状态&#xa;• 门户显示四项目 E2E 覆盖&#xa;• 门户显示恢复就绪状态&#xa;• 门户显示交付清单和下一步动作&#xa;• 验收报告显示每个失败的分类和处理建议" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#eef2ff;strokeColor=#4f46e5;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="100" y="170" width="500" height="360" as="geometry" />
        </mxCell>
        <mxCell id="p6-project" value="项目达成能力&#xa;&#xa;• 公开接口有可审计快照&#xa;• MCP / CLI / HTTP 一致性有矩阵&#xa;• 漂移有分类和迁移说明&#xa;• 真实 E2E 不伪造通过&#xa;• 交付清单明确提交边界&#xa;• 门户只展示有产物支撑的状态" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ecfdf5;strokeColor=#059669;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="850" y="170" width="500" height="360" as="geometry" />
        </mxCell>
        <mxCell id="p6-evidence" value="必须提供的验收证据&#xa;&#xa;• 阶段开发计划 / 验收计划 / 实施前审计&#xa;• 专项测试结果&#xa;• 公开接口守护结果&#xa;• 基线回归结果&#xa;• 真实 E2E 结果或结构化理由&#xa;• PRD/规格检视&#xa;• 虚假通过审计&#xa;• 验收审计" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#fff7ed;strokeColor=#ea580c;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1600" y="170" width="500" height="360" as="geometry" />
        </mxCell>
        <mxCell id="p6-final" value="最终出门条件&#xa;V2.59-V2.62 覆盖矩阵没有无支撑的已接受行；所有范围内能力均为已接受、结构化不可用、结构化阻断、待审查或范围外；受保护 legacy 文件 diff 为空；无未关闭致命/重大问题。" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#fef2f2;strokeColor=#dc2626;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="260" y="760" width="1680" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p6-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="p6-user" target="p6-project">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="p6-project" target="p6-evidence">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#dc2626;strokeWidth=2;" edge="1" parent="1" source="p6-evidence" target="p6-final">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
